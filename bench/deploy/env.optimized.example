TTS_API=http://localhost:9093
MODEL_NAME=TTS-model
DYNAMIC_BATCHING=true
CUDA_GRAPH_BATCH=[0.5,1.0,1.5,2.0,3.0,4.0]
TORCH_COMPILE=false
MAX_BATCH_SIZE=8
MICROSLEEP=1e-4
DEFAULT_SPEAKER=husein
SPEAKERS=husein,idayu,arissa,haiqal
DEFAULT_TEMPERATURE=0.6
# First decode window (x50 tokens): the stitcher waits for playback_speed*50 + overlap*50
# LM tokens before the first audio byte. At the LM's ~530 tok/s single-stream (H20, TP=2)
# that gate is the whole TTFB: 1.5 -> 173 ms, 0.75 -> 102 ms, 0.5 -> 81 ms (measured
# 2026-09-04, on-box, mode=rule). 0.75 is bit-identical at the LM (tokens don't change), gave
# transcripts identical to a one-shot decode (Whisper, 7/7) and an envelope within 0.1 dB
# median of it; 0.5 biased the loudness normalizer +1 dB, so stop at 0.75. Later windows
# grow x2 (STREAM_CHUNK_GROWTH) regardless of this value.
DEFAULT_PLAYBACK_SPEED=0.75
DEFAULT_PLAYBACK_OVERLAP_SPEED=0.2
# LLM normalizer (mode=llm) round trip is ~0.55 s, all of it in front of the first byte.
# Default-on shortcut: skip the call when the text has nothing to normalize (no digit,
# symbol, ALL-CAPS/dotted token or abbreviation) -- output is identical, verified 51/51
# sentences against the live LLM (bench/normalizer_gate_eval.py). false = always call.
LLM_NORMALIZER_SKIP_PLAIN=true
# Alternative with no LLM in the loop at all: mode=spoken is a rule-based replica of the
# LLM normalizer (English/Malay/Mandarin/Tamil; ~85% verbatim agreement with the LLM on
# bench/normalizer_corpus.py, every number always read, ~25 us). Either set it as the default
# mode, or keep mode=llm and let the rules go first (LLM only for what they leave behind):
# DEFAULT_NORMALIZER_MODE=spoken
# LLM_NORMALIZER_RULE_FIRST=true
# Boundary-click ('snap') fix: crossfade adjacent decode chunks instead of hard-splicing.
STREAM_CROSSFADE=true
CROSSFADE_MS=12.0
HF_TOKEN=<your_hf_token>
HUGGING_FACE_HUB_TOKEN=<your_hf_token>
