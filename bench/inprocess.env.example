# Serving settings for bench/serve_inprocess.py, copied from the production job
# (ucc_slurm-ui-job jobs/tm-h20/tts-api-1024.sbatch as read on 2026-10-07). Check that file before
# trusting this one: it is the source, this is a snapshot. No secrets here.
#
# Two deliberate differences from production:
#   DEFAULT_NORMALIZE_MALAYSIAN=false  evaluation clients send text already in spoken form, and
#                                      the LLM normalizer would reword each request differently
#   no OPENAI_*, SENTRY_*, OTLP_*      nothing here calls out
MODEL_NAME=TTS-model
DYNAMIC_BATCHING=true
CUDA_GRAPH_LAZY=false
CUDA_GRAPH_BATCH=[]
MAX_BATCH_SIZE=8
TORCH_COMPILE=false
SPEAKERS=TM_Mandarin,TM_English,TM_Malay,TM_English_Normal,husein,idayu
DEFAULT_SPEAKER=TM_English_Normal
DEFAULT_TEMPERATURE=0.6
DEFAULT_NORMALIZE_MALAYSIAN=false
DEFAULT_PLAYBACK_SPEED=0.75
INTERLEAVE_STORE=file
MAX_RETAIN_INTERLEAVE=5
LM_MAX_MODEL_LEN=4096
FADE_IN_MS=10
LOG_STDOUT=true
