TTS_API=http://tts-engine:9093

# Speech context for the `request_id` field (alias `context_id` / X-Context-Id header):
# consecutive chunks of one call are generated in the context of the previous ones.
# file = shared by all uvicorn workers on this host (default dir /dev/shm/tts-context);
# memory = single process; off = ignore request_id.
CONTEXT_STORE=file
# CONTEXT_STORE_DIR=/dev/shm/tts-context
CONTEXT_MAX_S=20
CONTEXT_TTL_S=600
CONTEXT_MIN_GEN_TOKENS=1000
# must match vLLM --max-model-len (vllm.yaml)
LM_MAX_MODEL_LEN=4096
