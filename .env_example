TTS_API=http://tts-engine:9093

# Interleaved generation for the `interleave_id` field (aliases `request_id` /
# `context_id`, or the X-Interleave-Id / X-Context-Id header): consecutive chunks of one
# reply are generated with the previous chunks' text + speech tokens in the prompt, in
# the interleaved format the LM was trained on.
# NEEDS an LM trained on interleaved documents -- private in-house checkpoints; no
# open-source TTS model has the packing. Serving anything else, set `off`: the prompt
# buys nothing there and cuts ~7.5% of chunks short.
# See INTERLEAVE.md (design) and bench/INTERLEAVE_AB.md (the measurement).
# file = shared by all uvicorn workers on this host (default dir /dev/shm/tts-interleave);
# memory = single process; off = ignore the id.
INTERLEAVE_STORE=file
# INTERLEAVE_STORE_DIR=/dev/shm/tts-interleave
# how many previous turns are retained per id and prompted (0 = seconds cap only)
MAX_RETAIN_INTERLEAVE=5
INTERLEAVE_MAX_S=20
INTERLEAVE_TTL_S=600
INTERLEAVE_MIN_GEN_TOKENS=1000
# regenerate a chunk without history if the LM stops after a handful of tokens
INTERLEAVE_FALLBACK=true
# must match vLLM --max-model-len (vllm.yaml)
LM_MAX_MODEL_LEN=4096
